# Copy this file to ~/.bash_secrets (untracked — see .gitignore) and fill
# in real values. ~/.bashrc sources ~/.bash_secrets automatically if present.
#
#   cp .bash_secrets.example ~/.bash_secrets
#   chmod 600 ~/.bash_secrets
#   nano ~/.bash_secrets

# Gmail account used by email()/emn()/getmail() (smtp.gmail.com:465 / imap.gmail.com:993).
# GMAIL_APP_PASSWORD must be a Google Account "app password", not your
# normal login password: https://myaccount.google.com/apppasswords
# IMAP must also be enabled on this account for getmail() to work:
# Gmail Settings -> Forwarding and POP/IMAP -> Enable IMAP.
export GMAIL_USER="you@gmail.com"
export GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Optional: default From/To used by email()/emn() when not passed explicitly.
# EMAIL_FROM defaults to $GMAIL_USER if unset.
#export EMAIL_FROM="you@gmail.com"
#export EMAIL_TO="destination@example.com"

# Required for getmail(): only messages From this address are ever processed.
export MAIL_TRUSTED_SENDER="you@example.com"

# Optional: where getmail() saves attachments. Defaults to ~/incoming.
#export MAIL_INBOX_DIR="$HOME/incoming"
